# SceneShift web (Vercel). Copy to .env.local for local runs; on Vercel set these in Project -> Settings -> Environment Variables.
# NEVER put real values in this file or in git. ARK_API_KEY does NOT belong here: it lives only on the PC that runs the worker.

# --- who may do what ---------------------------------------------------------------
REQUEST_PASSCODE=change-me            # needed to submit a request on /
ADMIN_PASSWORD=change-me-too          # /admin login
SESSION_SECRET=long-random-string     # signs the admin cookie (>= 32 chars)
WORKER_SECRET=long-random-string      # the PC worker sends it in the X-Worker-Secret header (>= 32 chars)
IP_HASH_SALT=another-random-string    # IPs are stored only as salted hashes

# --- money -------------------------------------------------------------------------
DAILY_CAP_USD=5.0                     # enforced at approval here AND by the worker on the PC
MAX_COST_PER_SCENE_USD=2.0
PRICE_PER_MTOKEN_USD=10.7             # Seedance tokens -> dollars for the estimate

# --- limits ------------------------------------------------------------------------
REQUESTS_PER_HOUR_PER_IP=5

# --- storage (Vercel Marketplace: Upstash Redis + Vercel Blob; both set these automatically when you connect them) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=
BLOB_READ_WRITE_TOKEN=

# --- local development only (never on Vercel) ---------------------------------------
# STORE_DRIVER=local                  # file-backed store in web/.local-store instead of Upstash
# BLOB_DRIVER=local                   # files in web/.local-blob served by /api/blob/... instead of Vercel Blob
# PUBLIC_BASE_URL=http://127.0.0.1:3000
